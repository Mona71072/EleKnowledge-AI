# 📋 EleKnowledge-AI 環境変数テンプレート

# このファイルは環境変数のテンプレートです。
# 実際の値は .env ファイルに記載してください。
# .env ファイルは .gitignore に含まれているため、Gitにコミットされません。

# ==============================================================================
# AWS 基本設定
# ==============================================================================
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=<AWS_ACCOUNT_ID>

# ==============================================================================
# Amazon Cognito 設定
# ==============================================================================
# Phase 1 スタック (EleKnowledge-dev-phase1) の Outputs から取得
COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ==============================================================================
# Amazon Bedrock 設定
# ==============================================================================
# Phase 2 デプロイ後、新規作成した General RAG Knowledge Base の ID に置き換える
# (既存の GenU 環境の Knowledge Base は他部門管理のため転用しない。新規作成すること)
BEDROCK_KB_ID=pending
# 推論プロファイル ID を使用すること。ベアなモデル ID (anthropic.claude-*) は
# ap-northeast-1 では LEGACY 扱いで invoke_model が失敗する
BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock Agent 設定 (Phase 3) — Phase 3 デプロイ前に Bedrock コンソールで作成
BEDROCK_AGENT_ID=pending
BEDROCK_AGENT_ALIAS_ID=pending
BEDROCK_REGION=ap-northeast-1

# ==============================================================================
# Amazon DynamoDB 設定
# ==============================================================================
# aws-resource-map.md の命名規則 (dev 環境)
DYNAMODB_USERS_TABLE=users-dev
DYNAMODB_CHATLOGS_TABLE=chatlogs-dev

# ==============================================================================
# Amazon S3 設定
# ==============================================================================
# 既存の GenU/他部門管理バケットは使用せず、Phase 1 テンプレートで新規作成される
# documents-dev-${AWS::AccountId} / uploads-dev-${AWS::AccountId} を使用する
S3_DOCUMENTS_BUCKET=documents-dev-<AWS_ACCOUNT_ID>
S3_UPLOADS_BUCKET=uploads-dev-<AWS_ACCOUNT_ID>
S3_REGION=ap-northeast-1

# ==============================================================================
# Amazon API Gateway 設定
# ==============================================================================
# 各 Phase デプロイ後の CloudFormation Outputs (AuthApiUrl / RagApiUrl / ChatApiUrl) を反映
API_GATEWAY_AUTH_URL=https://xxxxxx.execute-api.ap-northeast-1.amazonaws.com/dev
API_GATEWAY_RAG_URL=https://yyyyyy.execute-api.ap-northeast-1.amazonaws.com/dev
API_GATEWAY_CHAT_URL=https://zzzzzz.execute-api.ap-northeast-1.amazonaws.com/dev
API_GATEWAY_STAGE=dev

# ==============================================================================
# AWS Lambda 設定
# ==============================================================================
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY_SIZE=512

# ==============================================================================
# セキュリティ設定
# ==============================================================================
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING

# ==============================================================================
# 機能フラグ
# ==============================================================================
FEATURE_TROUBLESHOOTING_ENABLED=true
# 担当者向けMarkdown確認・工技先輩の開発画面（既定OFF）
NEXT_PUBLIC_ENABLE_KNOWLEDGE_WORKBENCH=false
# 工技先輩の照合画面は、frontend/.env.localに既存開発環境のRagApiUrlを指定
# 下書きMarkdownは送信せず、質問欄だけを通常・法令の各モードへ送信する
NEXT_PUBLIC_RAG_API_URL=https://example.execute-api.ap-northeast-1.amazonaws.com/dev
FEATURE_QUALITY_CHECK_ENABLED=false

# ==============================================================================
# 開発環境設定
# ==============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ==============================================================================
# 本番環境設定
# ==============================================================================
# CUSTOM_DOMAIN=eleknowledge-ai.com
# SSL_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-1:<AWS_ACCOUNT_ID>:certificate/CERT_ID

# ==============================================================================
# 監視設定
# ==============================================================================
ALERT_EMAIL=alert@example.com

# ==============================================================================
# 注意事項
# ==============================================================================
# 1. 強力なランダム文字列を使用
# 2. 機密情報は Secrets Manager で管理
# 3. .env ファイルは Git にコミットしない
# 4. 環境変数変更後は再起動が必要
